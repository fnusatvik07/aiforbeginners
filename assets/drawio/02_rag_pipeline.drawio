        <mxCell id="la" value="1 &#183; INDEXING &#8212; runs once, offline, when documents change" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#D4A27F;fontSize=11;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="75" width="640" height="20" as="geometry"/></mxCell>
        <mxCell id="d1" value="Your docs&#10;PDFs &#183; wiki &#183; tickets" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#232220;strokeColor=#D4A27F;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="50" y="105" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="d2" value="Split into chunks&#10;~500 tokens, with overlap" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#232220;strokeColor=#D4A27F;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="270" y="105" width="170" height="70" as="geometry"/></mxCell>
