        <mxCell id="vs" value="Vector store&#10;&#10;InMemory &#183; Chroma&#10;pgvector &#183; Pinecone&#10;&#10;vector + original text" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1E2620;strokeColor=#86A98C;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;fontStyle=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="720" y="105" width="190" height="300" as="geometry"/></mxCell>
        <mxCell id="lb" value="2 &#183; RETRIEVAL &#8212; runs on every single user question" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#CC785C;fontSize=11;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="300" width="640" height="20" as="geometry"/></mxCell>
        <mxCell id="q1" value="User question&#10;&#34;what is our refund window?&#34;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E2320;strokeColor=#CC785C;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="50" y="330" width="170" height="75" as="geometry"/></mxCell>
