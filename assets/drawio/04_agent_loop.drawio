<mxfile host="app.diagrams.net" type="device">
  <diagram name="Agent loop" id="agent-loop">
    <mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1"
                  arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="780"
                  background="#1B1A18" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="The agent loop &#8212; an agent is a while loop around a tool call" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#F0EEE6;fontSize=20;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="850" height="30" as="geometry"/></mxCell>
        <mxCell id="a1" value="1 &#183; Model decides&#10;answer, or call a tool?" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E2320;strokeColor=#CC785C;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="320" y="110" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="a2" value="2 &#183; Your code acts&#10;runs the function" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#232220;strokeColor=#D4A27F;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="580" y="260" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="a3" value="3 &#183; Observe&#10;append result to messages" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#20262A;strokeColor=#7E9FB4;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="320" y="410" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="a4" value="4 &#183; Repeat&#10;call the model again" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#232220;strokeColor=#3A3730;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="80" y="260" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="ex" value="Exit&#10;when it answers instead&#10;of calling a tool" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1E2620;strokeColor=#86A98C;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;fontStyle=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="620" y="105" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="g1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CC785C;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;fontColor=#A8A49B;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#1B1A18;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CC785C;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;fontColor=#A8A49B;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#1B1A18;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CC785C;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;fontColor=#A8A49B;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#1B1A18;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CC785C;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;fontColor=#A8A49B;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#1B1A18;" edge="1" parent="1" source="a4" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="g5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#86A98C;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;fontColor=#A8A49B;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#1B1A18;" edge="1" parent="1" source="a1" target="ex"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="code" value="for step in range(MAX_STEPS):&#10;    reply = model_with_tools.invoke(messages)&#10;    messages.append(reply)&#10;&#10;    if not reply.tool_calls:&#10;        return reply.content&#10;&#10;    for call in reply.tool_calls:&#10;        messages.append(BY_NAME[call[&#34;name&#34;]].invoke(call))" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#121110;strokeColor=#3A3730;strokeWidth=2;fontColor=#F0EEE6;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;align=left;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="80" y="540" width="560" height="160" as="geometry"/></mxCell>
        <mxCell id="lc" value="&#8230;or one line:&#10;&#10;agent = create_agent(model, tools=TOOLS)&#10;agent.invoke({&#34;messages&#34;: [&#8230;]},&#10;             config={&#34;recursion_limit&#34;: 12})&#10;&#10;Same loop, plus streaming, retries,&#10;memory, approval gates and tracing." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E2320;strokeColor=#CC785C;strokeWidth=2;fontColor=#F0EEE6;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;align=left;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="690" y="540" width="420" height="160" as="geometry"/></mxCell>
        <mxCell id="f" value="MAX_STEPS is not optional. An agent without a cap is a budget without a floor." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#D4A27F;fontSize=13;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="715" width="900" height="25" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
