<mxfile host="app.diagrams.net" type="device">
  <diagram name="Tool calling" id="tool-calling">
    <mxGraphModel dx="1400" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1"
                  arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720"
                  background="#1B1A18" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="Tool calling &#8212; the model never runs your code, it asks you to" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#F0EEE6;fontSize=20;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="850" height="30" as="geometry"/></mxCell>
        <mxCell id="cA" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#201C1A;strokeColor=#3A3730;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="40" y="80" width="380" height="560" as="geometry"/></mxCell>
        <mxCell id="lA" value="YOUR CODE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#CC785C;fontSize=13;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="380" height="24" as="geometry"/></mxCell>
        <mxCell id="cB" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1A1E20;strokeColor=#3A3730;strokeWidth=2;fontColor=#F0EEE6;fontSize=13;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=1;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="740" y="80" width="380" height="560" as="geometry"/></mxCell>
        <mxCell id="lB" value="THE MODEL" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#7E9FB4;fontSize=13;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="95" width="380" height="24" as="geometry"/></mxCell>
        <mxCell id="s1" value="1 &#183; You send the question&#10;AND the menu of tools&#10;&#10;model.bind_tools([...])" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E2320;strokeColor=#CC785C;strokeWidth=2;fontColor=#F0EEE6;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="70" y="150" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="s2" value="2 &#183; It replies with a REQUEST,&#10;not an answer&#10;&#10;content is empty&#10;tool_calls: [get_order_status]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#20262A;strokeColor=#7E9FB4;strokeWidth=2;fontColor=#F0EEE6;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="770" y="270" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="s3" value="3 &#183; YOU execute the function&#10;&#10;get_order_status(&#34;48213&#34;)&#10;&#8594; {&#34;status&#34;: &#34;shipped&#34;}" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1E2620;strokeColor=#86A98C;strokeWidth=2;fontColor=#F0EEE6;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="70" y="400" width="320" height="95" as="geometry"/></mxCell>
        <mxCell id="s4" value="4 &#183; You send the whole history&#10;plus the tool result&#10;&#10;messages + AIMessage + ToolMessage" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2E2320;strokeColor=#CC785C;strokeWidth=2;fontColor=#F0EEE6;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="70" y="520" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="s5" value="5 &#183; Now it answers,&#10;grounded in real data&#10;&#10;&#34;Your order 48213 has shipped.&#34;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1E2620;strokeColor=#86A98C;strokeWidth=2;fontColor=#F0EEE6;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;align=center;dashed=0;spacingLeft=8;spacingRight=8" vertex="1" parent="1"><mxGeometry x="770" y="490" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="t1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CC785C;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;fontColor=#A8A49B;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#1B1A18;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7E9FB4;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;fontColor=#A8A49B;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#1B1A18;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#86A98C;strokeWidth=2;dashed=1;endArrow=blockThin;endFill=1;fontColor=#A8A49B;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#1B1A18;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#CC785C;strokeWidth=2;dashed=0;endArrow=blockThin;endFill=1;fontColor=#A8A49B;fontSize=10;fontFamily=Helvetica;labelBackgroundColor=#1B1A18;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f" value="Two API round trips for one tool use. That gate at step 3 is where every safety control lives." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#D4A27F;fontSize=13;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="900" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
